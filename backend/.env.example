# 生产环境环境变量模板
# 复制此文件为 .env 并填入实际值

# ================================
# 应用基本配置
# ================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ================================
# 数据库配置
# ================================
DB_URL=jdbc:mysql://localhost:3306/library_db?useSSL=true&serverTimezone=Asia/Tokyo&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=5382

# ================================
# Redis配置
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0

# ================================
# JWT安全配置
# ================================
# JWT密钥必须至少256位(32字符)
JWT_SECRET=your_very_secure_jwt_secret_key_at_least_256_bits_long_abcdefghijklmnopqrstuvwxyz
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# ================================
# 会话管理配置
# ================================
MAX_SESSIONS=1
PREVENT_LOGIN_IF_MAX_EXCEEDED=true

# ================================
# 可选配置
# ================================
# 日志级别
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_DEMO=INFO

# 数据库连接池配置
HIKARI_MAXIMUM_POOL_SIZE=20
HIKARI_MINIMUM_IDLE=5

# Redis连接池配置
REDIS_LETTUCE_POOL_MAX_ACTIVE=20
REDIS_LETTUCE_POOL_MAX_IDLE=10